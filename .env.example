# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

# The Go API's origin. The browser calls it directly, so it must match the API's
# GOOGLE_REDIRECT_URL origin (sign-in cookies belong to that host). See docs/adr/0002-auth.md.
# Sign-in also needs the API started with DATABASE_URL, JWT_SECRET, GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET set, and its FRONTEND_URL set to this site (http://localhost:3000).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"

# Optional. The Go API's real origin, for "proxy mode" (docs/adr/0002-auth.md): the
# site forwards /api/v1/* and /auth/google/* to it, so NEXT_PUBLIC_API_BASE_URL is
# then this site's own origin. Leave unset in local development.
# API_PROXY_TARGET="https://api.example.run.app"
