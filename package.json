  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "next dev --turbo",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
