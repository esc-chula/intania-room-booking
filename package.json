    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "next": "^15.2.3",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.7.0",
